{
  "name": "pertech-production",
  "version": "1.0.19",
  "description": "Production Test Application",
  "homepage": "https://productionapp.pertechindustries.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:api": "./start-local-api.sh",
    "start:mac": "./run-local-mac.sh",
    "dist": "build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo"
  ],
  "build": {
    "appId": "com.pertechindustries.production",
    "productName": "Pertech Production",
    "files": [
      "**/*",
      "!dist/**",
      "!local-api/**",
      "!*.log",
      "!.php-sessions/**",
      "!local-api/production/uploads/**"
    ],
    "extraResources": [
      {
        "from": "local-api",
        "to": "local-api"
      }
    ],
    "mac": {
      "icon": "./build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "author": "Pertech <contact@pertechindustries.com>",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^22.14.13"
  },
  "dependencies": {
    "form-data": "^2.3.3",
    "graceful-fs": "^4.1.15",
    "serialport": "^10.5.0"
  }
}
