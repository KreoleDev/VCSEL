{
  "name": "pertech-vcsel",
  "version": "1.0.19",
  "description": "Production VCSEL Test Application",
  "homepage": "https://productionapp.pertechindustries.com",
  "main": "main.js",
  "scripts": {
    "start": "./run-local-linux.sh",
    "dist": "./build-production-linux.sh",
    "postinstall": "echo skip postinstall"
  },
  "keywords": [
    "Electron",
    "VCSEL",
    "Pertech",
    "Production",
    "Test"
  ],
  "build": {
    "appId": "com.pertechindustries.vcsel",
    "productName": "VCSEL",
    "artifactName": "Pertech-VCSEL-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "renderer.js",
      "router.js",
      "index.html",
      "config.js",
      "package.json",
      "pages/**/*",
      "lib/**/*",
      "build/icons/**/*",
      "!dashboard/**",
      "!dist/**",
      "!node_modules/.cache/**",
      "!*.zip",
      "!*.log",
      "!.git/**",
      "!.php-sessions/**",
      "!**/.DS_Store"
    ],
    "linux": {
      "icon": "./build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "packageCategory": "utils",
      "priority": "optional"
    }
  },
  "author": "Pertech <development@pertechindustries.com>",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=14.18.0"
  },
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "form-data": "^2.3.3",
    "graceful-fs": "^4.1.15",
    "serialport": "^10.5.0"
  }
}
